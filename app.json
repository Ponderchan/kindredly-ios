{
  "expo": {
    "name": "Kindredly",
    "slug": "kindredly",
    "version": "1.3.0",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "scheme": "kindredly",
    "userInterfaceStyle": "light",
    "backgroundColor": "#5B55FF",
    "ios": {
      "bundleIdentifier": "io.kindredly.app",
      "usesAppleSignIn": true,
      "supportsTablet": false,
      "deploymentTarget": "18.0",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleAllowMixedLocalizations": true
      },
      "appleTeamId": "SSSB423982",
      "icon": {
        "light": "./assets/icon.png",
        "dark": "./assets/icon-dark.png",
        "tinted": "./assets/icon-tinted.png"
      }
    },
    "plugins": [
      "expo-router",
      "expo-apple-authentication",
      "expo-web-browser",
      [
        "expo-font",
        {
          "ios": {
            "fonts": [
              "./assets/fonts/Fraunces-Regular.ttf",
              "./assets/fonts/Fraunces-SemiBold.ttf",
              "./assets/fonts/Fraunces-Italic.ttf",
              "./assets/fonts/Inter-Regular.ttf",
              "./assets/fonts/Inter-Medium.ttf",
              "./assets/fonts/Inter-SemiBold.ttf",
              "./assets/fonts/Inter-Bold.ttf",
              "./assets/fonts/Inter-ExtraBold.ttf",
              "./assets/fonts/IBMPlexMono-Regular.ttf",
              "./assets/fonts/IBMPlexMono-Medium.ttf",
              "./assets/fonts/IBMPlexMono-SemiBold.ttf",
              "./assets/fonts/Newsreader-Regular.ttf",
              "./assets/fonts/Newsreader-Italic.ttf",
              "./assets/fonts/EBGaramond-Regular.ttf"
            ]
          }
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Kindredly uses the microphone so you can record a voice letter or a voice journal page.",
          "enableBackgroundPlayback": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-media-library",
        {
          "savePhotosPermission": "Kindredly saves your aura card to your photos when you ask it to.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Kindredly opens your photo library so you can add a photo or video to a private journal page.",
          "cameraPermission": false
        }
      ],
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": false,
          "supportsPictureInPicture": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#5B55FF",
          "image": "./assets/splash-ground.png",
          "imageWidth": 1,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#6E5FD8"
        }
      ],
      [
        "expo-widgets",
        {
          "groupIdentifier": "group.io.kindredly.app",
          "enablePushNotifications": true
        }
      ],
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "29aafd7c-6f2c-4965-99f1-cb6d2e0ee638"
      }
    },
    "owner": "blockchan",
    "locales": {
      "en": "./locales/en.json",
      "es": "./locales/es.json",
      "pt-BR": "./locales/pt-BR.json",
      "id": "./locales/id.json",
      "fr": "./locales/fr.json",
      "de": "./locales/de.json",
      "it": "./locales/it.json",
      "ja": "./locales/ja.json",
      "ko": "./locales/ko.json"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/29aafd7c-6f2c-4965-99f1-cb6d2e0ee638",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
